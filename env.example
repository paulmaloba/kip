# Project Kwacha - Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (it should be in .gitignore)

# ===================================
# API Keys (Week 1-3)
# ===================================

# Trading Economics API
# Get free trial at: https://tradingeconomics.com/api
TRADING_ECONOMICS_KEY=your_trading_economics_key_here

# Hugging Face Token (Optional for Week 1, Required for Week 4)
# Get at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ===================================
# Database Configuration (Week 8+)
# ===================================

# PostgreSQL (for structured data)
DATABASE_URL=postgresql://username:password@localhost:5432/kwacha_db

# MongoDB (for unstructured data)
MONGODB_URL=mongodb://localhost:27017/kwacha_db

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# ===================================
# API Configuration (Week 8+)
# ===================================

# FastAPI settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# Security
SECRET_KEY=your_secret_key_here_generate_with_openssl
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===================================
# Model Configuration (Week 4+)
# ===================================

# Model paths
BUSINESS_GENERATOR_MODEL_PATH=models/business_generator/checkpoints/best_model
ECONOMIC_FORECASTER_MODEL_PATH=models/economic_forecaster/lstm/best_model.pth

# Training settings
TRAINING_BATCH_SIZE=4
TRAINING_EPOCHS=3
LEARNING_RATE=2e-4

# ===================================
# External Services (Optional)
# ===================================

# Sentry (for error monitoring)
SENTRY_DSN=your_sentry_dsn_here

# AWS (if using cloud deployment)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1

# ===================================
# Application Settings
# ===================================

# Environment
ENVIRONMENT=development  # development, staging, production

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Data paths
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
SYNTHETIC_DATA_DIR=data/synthetic

# ===================================
# Feature Flags
# ===================================

# Enable/disable features
ENABLE_REAL_TIME_DATA=False
ENABLE_SYNTHETIC_DATA=True
ENABLE_CACHING=False
